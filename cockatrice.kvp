Meta.DisplayName=Cockatrice - Servatrice (TeamKit)
Meta.Description=Servatrice, le serveur officiel de Cockatrice (jeu de cartes a collectionner en ligne, Magic et autres, gratuit, libre, jeu traduit en francais). Telecharge a chaque Update depuis les versions GitHub de Cockatrice (paquet du serveur seul). Comptes au choix : ouvert (pseudo libre, sans base), comptes enregistres (inscription depuis le jeu, sans e-mail ; MariaDB integree a l instance ou externe) ou mot de passe commun. Salon francophone et message d'accueil TeamKit. Le serveur n'apparait pas dans la liste du jeu : les joueurs ajoutent l'adresse et le port (4747) dans Se connecter au serveur.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=TeamKit
Meta.URL=https://github.com/hydrocut/AMPTemplates-Cockatrice
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/Cockatrice/Cockatrice/master/cockatrice/resources/cockatrice.svg
Meta.EndpointURIFormat=
Meta.ConfigManifest=cockatriceconfig.json
Meta.MetaConfigManifest=cockatricemetaconfig.json
Meta.ConfigRoot=cockatrice.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=Servatrice a besoin des bibliotheques Qt 6 et protobuf de Debian 13 (et, pour le mode comptes, du pilote MySQL de Qt, du client et du serveur MariaDB) : ExtraContainerPackages les installe a la creation du conteneur.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["libqt6core6t64","libqt6network6","libqt6sql6","libqt6websockets6","libprotobuf32t64","libqt6sql6-mysql","mariadb-client","mariadb-server-core"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=e9c887d0-44f1-4f56-bddd-f9ddd699217d
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
